{
  "name": "devcrew-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent software planning web application for transforming ideas into development blueprints",
  "keywords": [
    "software-planning",
    "ai-agents",
    "development-blueprint",
    "nextjs",
    "typescript"
  ],
  "author": "DevCrew AI Team",
